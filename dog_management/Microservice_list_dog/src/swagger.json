{
  "swagger": "2.0",
  "info": {
    "title": "Dog API",
    "description": "API for managing and retrieving dog records",
    "version": "1.0.0"
  },
  "host": "localhost:4001",
  "basePath": "/",
  "schemes": [
    "http",
    "https"
  ],
  "paths": {
    "/list": {
      "get": {
        "summary": "Retrieve a list of dogs",
        "description": "Returns an array of dog objects",
        "tags": ["Dogs"],
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "List of dogs retrieved successfully",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Dog"
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "definitions": {
    "Dog": {
      "type": "object",
      "required": ["nameDog", "breed", "age"],
      "properties": {
        "nameDog": {
          "type": "string",
          "example": "Buddy",
          "description": "Name of the dog"
        },
        "breed": {
          "type": "string",
          "example": "Labrador",
          "description": "Breed of the dog"
        },
        "age": {
          "type": "integer",
          "example": 3,
          "description": "Age of the dog in years"
        },
        "gender": {
          "type": "string",
          "enum": ["Male", "Female"],
          "example": "Male",
          "description": "Gender of the dog"
        }
      }
    }
  }
}
