{
  "swagger": "2.0",
  "info": {
    "title": "Vaccine API",
    "description": "API for updating vaccines.",
    "version": "1.0.0"
  },
  "host": "localhost:3004",
  "basePath": "/api",
  "schemes": ["http", "https"],
  "tags": [
    {
      "name": "Vaccines",
      "description": "Endpoints for managing vaccines"
    }
  ],
  "paths": {
    "/updateVaccines": {
      "put": {
        "summary": "Update a vaccine",
        "tags": ["Vaccines"],
        "description": "Updates vaccine details using its ID.",
        "parameters": [
          {
            "name": "vaccine",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/VaccineUpdate"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vaccine updated successfully"
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "definitions": {
    "VaccineUpdate": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "example": "abc123" },
        "name": { "type": "string", "example": "COVID-19 Vaccine" },
        "description": { "type": "string", "example": "Updated description" },
        "dose": { "type": "integer", "example": 2 }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "message": { "type": "string", "example": "Bad Request" }
      }
    }
  }
}
